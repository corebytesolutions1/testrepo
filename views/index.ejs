<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary SEO -->
  <title><%= title %></title>
  <meta name="description" content="<%= description %>" />
  <meta name="keywords" content="scrap metal export UK, commodity trading, scrap import export, UK scrap dealer, ferrous scrap, non-ferrous scrap, metal trading, Wahenoor Exports, WEL Exports, global trading UK" />
  <meta name="author" content="Wahenoor Exports Limited" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href="<%= canonical %>" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= canonical %>" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= description %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:site_name" content="Wahenoor Exports Limited" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= title %>" />
  <meta name="twitter:description" content="<%= description %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />

  <!-- Structured Data: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://www.welexports.com/#organization",
    "name": "Wahenoor Exports Limited",
    "alternateName": "WEL Exports",
    "url": "https://www.welexports.com",
    "logo": "https://www.welexports.com/images/logo.png",
    "image": "https://www.welexports.com/images/og-image.jpg",
    "description": "UK-based global trading company specialising in export and import of all types of scrap metals and commodities.",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "GB"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "info@welexports.com",
      "telephone": "+44-70-0000-0000",
      "availableLanguage": ["English"]
    },
    "sameAs": [],
    "areaServed": "Worldwide",
    "knowsAbout": ["Scrap Metal Trading", "Commodity Export", "Import Export", "Ferrous Scrap", "Non-Ferrous Scrap", "Stainless Steel Trading"]
  }
  </script>

  <!-- Structured Data: WebSite (sitelinks search box eligibility) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://www.welexports.com/#website",
    "url": "https://www.welexports.com",
    "name": "Wahenoor Exports Limited",
    "publisher": { "@id": "https://www.welexports.com/#organization" },
    "inLanguage": "en-GB"
  }
  </script>

  <!-- Structured Data: WebPage + Breadcrumb -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "<%= canonical %>#webpage",
    "url": "<%= canonical %>",
    "name": "<%= title %>",
    "description": "<%= description %>",
    "isPartOf": { "@id": "https://www.welexports.com/#website" },
    "about": { "@id": "https://www.welexports.com/#organization" },
    "inLanguage": "en-GB",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.welexports.com/"
        }
      ]
    }
  }
  </script>

  <!-- Structured Data: Services -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Scrap Metal & Commodity Export/Import Trading",
    "provider": { "@id": "https://www.welexports.com/#organization" },
    "areaServed": "Worldwide",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Trading Categories",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ferrous Scrap Trading", "description": "Export and import of HMS 1&2, shredded steel, cast iron, structural steel and rails." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Non-Ferrous Metals Trading", "description": "Trading of copper, aluminium, brass, lead, zinc and nickel scrap and alloys." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Stainless & Alloy Steel Trading", "description": "Trading of stainless steel grades, high-alloy steels and specialty metal scrap." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "General Commodity Trading", "description": "Import and export of industrial machinery, used auto parts, rubber and mixed industrial lots." } }
      ]
    }
  }
  </script>

  <!-- Performance: Preconnect & Preload -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="preconnect" href="https://cdn.emailjs.com" crossorigin />
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

  <link rel="preload" as="style" href="/css/style.css?v=<%= v %>" />
  <link rel="preload" as="script" href="/js/main.js" />

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <!-- EmailJS (deferred — not render-blocking) -->
  <script src="https://cdn.emailjs.com/dist/email.min.js" defer></script>

  <link rel="stylesheet" href="/css/style.css?v=<%= v %>" />
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <meta name="theme-color" content="#0D0D0F" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>

  <!-- ====== PRELOADER ====== -->
  <div id="preloader">
    <div class="preloader-inner">
      <div class="preloader-logo">WEL</div>
      <div class="preloader-bar"><div class="preloader-fill"></div></div>
    </div>
  </div>

  <!-- ====== NAVBAR ====== -->
  <header id="navbar">
    <nav class="nav-container">
      <a href="#hero" class="nav-logo">
        <span class="logo-mark">WEL</span>
        <div class="logo-text">
          <span class="logo-main">Wahenoor Exports</span>
          <span class="logo-sub">Limited · Est. UK</span>
        </div>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#about" class="nav-link">About</a></li>
        <li><a href="#services" class="nav-link">Services</a></li>
        <li><a href="#why-us" class="nav-link">Why Us</a></li>
        <li><a href="#certificates" class="nav-link">Certificates</a></li>
        <li><a href="#contact" class="nav-link nav-cta">Get a Quote</a></li>
      </ul>
    </nav>
  </header>

  <!-- ====== HERO ====== -->
  <section id="hero">
    <canvas id="worldCanvas"></canvas>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="eyebrow-line"></span>
        United Kingdom · Global Reach
        <span class="eyebrow-line"></span>
      </div>
      <h1 class="hero-title">
        Trading the World's<br />
        <em>Most Vital</em> Commodities
      </h1>
      <p class="hero-subtitle">
        Wahenoor Exports Limited is a UK-registered trading house specialising in the global
        export and import of scrap metals, ferrous & non-ferrous materials, and industrial
        commodities — connecting suppliers and buyers across every continent.
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-gold">Request a Quote</a>
        <a href="#services" class="btn btn-outline">Our Services</a>
      </div>
      <div class="hero-badges">
        <div class="hero-badge">
          <i class="fas fa-flag-checkered"></i>
          <span>UK Registered Company</span>
        </div>
        <div class="hero-badge">
          <i class="fas fa-globe"></i>
          <span>Global Trade Network</span>
        </div>
        <div class="hero-badge">
          <i class="fas fa-shield-alt"></i>
          <span>Fully Compliant Documentation</span>
        </div>
      </div>
    </div>
    <a href="#about" class="hero-scroll" aria-label="Scroll down">
      <span class="scroll-text">Scroll</span>
      <span class="scroll-icon"><i class="fas fa-chevron-down"></i></span>
    </a>
  </section>

  <!-- ====== TICKER ====== -->
  <div class="ticker-wrap">
    <div class="ticker">
      <span>Ferrous Scrap</span>
      <span class="ticker-dot">◆</span>
      <span>Non-Ferrous Metals</span>
      <span class="ticker-dot">◆</span>
      <span>Copper Scrap</span>
      <span class="ticker-dot">◆</span>
      <span>Aluminium</span>
      <span class="ticker-dot">◆</span>
      <span>Steel & HMS</span>
      <span class="ticker-dot">◆</span>
      <span>Zinc & Lead</span>
      <span class="ticker-dot">◆</span>
      <span>Stainless Steel</span>
      <span class="ticker-dot">◆</span>
      <span>Industrial Commodities</span>
      <span class="ticker-dot">◆</span>
      <!-- Duplicate for seamless loop -->
      <span>Ferrous Scrap</span>
      <span class="ticker-dot">◆</span>
      <span>Non-Ferrous Metals</span>
      <span class="ticker-dot">◆</span>
      <span>Copper Scrap</span>
      <span class="ticker-dot">◆</span>
      <span>Aluminium</span>
      <span class="ticker-dot">◆</span>
      <span>Steel & HMS</span>
      <span class="ticker-dot">◆</span>
      <span>Zinc & Lead</span>
      <span class="ticker-dot">◆</span>
      <span>Stainless Steel</span>
      <span class="ticker-dot">◆</span>
      <span>Industrial Commodities</span>
      <span class="ticker-dot">◆</span>
    </div>
  </div>

  <!-- ====== ABOUT ====== -->
  <section id="about" class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-visual">
          <div class="about-badge">
            <i class="fas fa-globe"></i>
            <span>Global Trading House</span>
          </div>
          <div class="about-image-frame">
            <div class="about-image-inner">
              <div class="about-icon-grid">
                <div class="icon-tile"><i class="fas fa-industry"></i></div>
                <div class="icon-tile accent"><i class="fas fa-ship"></i></div>
                <div class="icon-tile"><i class="fas fa-recycle"></i></div>
                <div class="icon-tile accent"><i class="fas fa-globe-europe"></i></div>
                <div class="icon-tile accent"><i class="fas fa-cogs"></i></div>
                <div class="icon-tile"><i class="fas fa-boxes"></i></div>
              </div>
            </div>
          </div>
          <div class="about-years">
            <span class="years-num"><i class="fas fa-certificate"></i></span>
            <span class="years-label">UK Registered &amp; Compliant</span>
          </div>
        </div>
        <div class="about-content">
          <div class="section-eyebrow">About Wahenoor Exports</div>
          <h2 class="section-title">A Trusted UK Bridge to<br /><em>Global Commodity Markets</em></h2>
          <p class="about-lead">
            Wahenoor Exports Limited (WEL) is a UK-registered trading and export-import company headquartered in the United Kingdom, operating at the intersection of global supply chains and industrial demand.
          </p>
          <p class="about-body">
            We specialise in the sourcing, trading, and international shipment of all categories of scrap metal — including ferrous, non-ferrous, and specialty alloys — alongside a broad portfolio of industrial commodities. Our team brings deep knowledge of international trade regulations, commodity markets, and logistics to every transaction.
          </p>
          <p class="about-body">
            From initial inquiry to final delivery, we manage the entire trade lifecycle: sourcing, grading, documentation, freight forwarding, customs clearance, and post-delivery support. We are building partnerships with manufacturers, recyclers, smelters, and commodity traders across Europe, Asia, the Middle East, and Africa.
          </p>
          <div class="about-pillars">
            <div class="pillar">
              <i class="fas fa-shield-alt"></i>
              <span>Fully UK Registered</span>
            </div>
            <div class="pillar">
              <i class="fas fa-file-contract"></i>
              <span>Compliant Documentation</span>
            </div>
            <div class="pillar">
              <i class="fas fa-handshake"></i>
              <span>End-to-End Service</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== SERVICES ====== -->
  <section id="services" class="section section-dark">
    <div class="container">
      <div class="section-header centered">
        <div class="section-eyebrow">What We Trade</div>
        <h2 class="section-title">Our Trading <em>Services</em></h2>
        <p class="section-desc">From ferrous metals to specialist industrial commodities, we facilitate seamless cross-border trade for buyers and sellers worldwide.</p>
      </div>
      <div class="services-grid">

        <div class="service-card" data-aos="fade-up">
          <div class="service-icon"><i class="fas fa-layer-group"></i></div>
          <div class="service-category">Category 01</div>
          <h3>Ferrous Scrap</h3>
          <p>Export and import of HMS 1&2, shredded steel, cast iron, structural steel, rails, and all grades of ferrous scrap metal.</p>
          <ul class="service-list">
            <li>HMS 1 & HMS 2</li>
            <li>Shredded Steel</li>
            <li>Cast Iron Scrap</li>
            <li>Railway Scrap (Rails)</li>
          </ul>
          <a href="#contact" class="service-link">Enquire <i class="fas fa-arrow-right"></i></a>
        </div>

        <div class="service-card featured" data-aos="fade-up" data-aos-delay="100">
          <div class="service-badge">Most Traded</div>
          <div class="service-icon"><i class="fas fa-atom"></i></div>
          <div class="service-category">Category 02</div>
          <h3>Non-Ferrous Metals</h3>
          <p>Specialist trading of high-value non-ferrous scrap including copper, aluminium, brass, lead, zinc and nickel alloys.</p>
          <ul class="service-list">
            <li>Copper Wire & Millberry</li>
            <li>Aluminium Alloys & Extrusions</li>
            <li>Brass & Bronze Scrap</li>
            <li>Lead, Zinc & Nickel</li>
          </ul>
          <a href="#contact" class="service-link">Enquire <i class="fas fa-arrow-right"></i></a>
        </div>

        <div class="service-card" data-aos="fade-up" data-aos-delay="200">
          <div class="service-icon"><i class="fas fa-tint"></i></div>
          <div class="service-category">Category 03</div>
          <h3>Stainless & Alloy Steel</h3>
          <p>Trading of stainless steel grades, high-alloy steels, tool steels, and specialty metal scrap for global re-melters and foundries.</p>
          <ul class="service-list">
            <li>SS 304 / 316 / 430 Scrap</li>
            <li>High-Speed Steel</li>
            <li>Inconel & Super Alloys</li>
            <li>Titanium Scrap</li>
          </ul>
          <a href="#contact" class="service-link">Enquire <i class="fas fa-arrow-right"></i></a>
        </div>

        <div class="service-card" data-aos="fade-up" data-aos-delay="300">
          <div class="service-icon"><i class="fas fa-truck-moving"></i></div>
          <div class="service-category">Category 04</div>
          <h3>Other Commodities</h3>
          <p>Beyond scrap, we facilitate international trade in a diverse range of industrial and commercial commodities as required by our clients.</p>
          <ul class="service-list">
            <li>Industrial Machinery</li>
            <li>Used Auto Parts</li>
            <li>Rubber & Tyres</li>
            <li>Mixed Industrial Lots</li>
          </ul>
          <a href="#contact" class="service-link">Enquire <i class="fas fa-arrow-right"></i></a>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== WHY US ====== -->
  <section id="why-us" class="section">
    <div class="container">
      <div class="section-header centered">
        <div class="section-eyebrow">Why Wahenoor Exports</div>
        <h2 class="section-title">The WEL <em>Advantage</em></h2>
        <p class="section-desc">We don't just move materials — we build trade relationships built on integrity, expertise, and operational excellence.</p>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-number">01</div>
          <div class="why-icon"><i class="fas fa-flag"></i></div>
          <h3>UK Registered & Regulated</h3>
          <p>Incorporated in the United Kingdom under the Companies Act, providing our global partners with the legal certainty and credibility of a fully regulated British company.</p>
        </div>
        <div class="why-card">
          <div class="why-number">02</div>
          <div class="why-icon"><i class="fas fa-network-wired"></i></div>
          <h3>Global Trade Network</h3>
          <p>We are actively building relationships with suppliers, buyers, freight forwarders, and port authorities across multiple continents to support seamless execution of every trade.</p>
        </div>
        <div class="why-card">
          <div class="why-number">03</div>
          <div class="why-icon"><i class="fas fa-clipboard-check"></i></div>
          <h3>Full Documentation Support</h3>
          <p>We handle all export/import documentation including certificates of origin, packing lists, commercial invoices, phytosanitary and environmental compliance certificates.</p>
        </div>
        <div class="why-card">
          <div class="why-number">04</div>
          <div class="why-icon"><i class="fas fa-balance-scale"></i></div>
          <h3>Transparent Pricing</h3>
          <p>No hidden fees, no last-minute surprises. Our commodity pricing is benchmarked against LME and live market data, ensuring you always get a fair and competitive rate.</p>
        </div>
        <div class="why-card">
          <div class="why-number">05</div>
          <div class="why-icon"><i class="fas fa-headset"></i></div>
          <h3>Dedicated Account Management</h3>
          <p>Every client receives a dedicated trade manager available throughout the transaction lifecycle, from first quote to post-delivery confirmation.</p>
        </div>
        <div class="why-card">
          <div class="why-number">06</div>
          <div class="why-icon"><i class="fas fa-leaf"></i></div>
          <h3>Environmental Compliance</h3>
          <p>All operations adhere to UK Environment Agency regulations, Basel Convention requirements, and destination-country import standards for waste and scrap materials.</p>
        </div>
      </div>

      <!-- Process Strip -->
      <div class="process-strip">
        <div class="section-eyebrow centered" style="margin-bottom: 2rem;">How We Work</div>
        <div class="process-steps">
          <div class="process-step">
            <div class="step-num">1</div>
            <div class="step-content">
              <h4>Enquiry</h4>
              <p>Submit your commodity requirements or selling offer</p>
            </div>
          </div>
          <div class="process-arrow"><i class="fas fa-chevron-right"></i></div>
          <div class="process-step">
            <div class="step-num">2</div>
            <div class="step-content">
              <h4>Assessment</h4>
              <p>We evaluate, grade, and quote within 24 hours</p>
            </div>
          </div>
          <div class="process-arrow"><i class="fas fa-chevron-right"></i></div>
          <div class="process-step">
            <div class="step-num">3</div>
            <div class="step-content">
              <h4>Contract</h4>
              <p>Formal trade agreement and compliance checks</p>
            </div>
          </div>
          <div class="process-arrow"><i class="fas fa-chevron-right"></i></div>
          <div class="process-step">
            <div class="step-num">4</div>
            <div class="step-content">
              <h4>Logistics</h4>
              <p>Freight, customs, and shipment coordination</p>
            </div>
          </div>
          <div class="process-arrow"><i class="fas fa-chevron-right"></i></div>
          <div class="process-step">
            <div class="step-num">5</div>
            <div class="step-content">
              <h4>Delivery</h4>
              <p>Final delivery, documentation, and confirmation</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== CERTIFICATES ====== -->
  <section id="certificates" class="section section-dark" >
    <div class="container">
      <div class="section-header centered">
        <div class="section-eyebrow">Credentials & Compliance</div>
        <h2 class="section-title">Our <em>Certifications</em></h2>
        <p class="section-desc">Our accreditations reflect our commitment to operating to the highest standards of legality, compliance, and environmental responsibility.</p>
      </div>

      <div class="certs-grid centered" id="certsGrid">

        <!-- Certificate cards — add more here as needed -->
        <div class="cert-card">
          <div class="cert-icon"><i class="fas fa-certificate"></i></div>
          <div class="cert-body">
            <div class="cert-issuer">Companies House, UK</div>
            <h3 class="cert-name">Certificate of Incorporation</h3>
            <p class="cert-desc">Wahenoor Exports Limited is fully incorporated under the Companies Act 2006, registered in England and Wales.</p>
            <div class="cert-footer">
              <div class="cert-tag">Company Registration</div>
              <a href="/certificates/certificate-of-incorporation.pdf" target="_blank" rel="noopener" class="cert-download" download>
                <i class="fas fa-download"></i> View / Download
              </a>
            </div>
          </div>
        </div>

        <div class="cert-card">
          <div class="cert-icon"><i class="fas fa-file-invoice"></i></div>
          <div class="cert-body">
            <div class="cert-issuer">Memorandum</div>
            <h3 class="cert-name">Memorandum</h3>
            <p class="cert-desc">Memorandum of Association of Wahenoor Exports Ltd</p>
            <div class="cert-footer">
              <div class="cert-tag">Memorendum of Company</div>
              <a href="/certificates/Memorandum.pdf" target="_blank" rel="noopener" class="cert-download" download>
                <i class="fas fa-download"></i> View / Download
              </a>
            </div>
          </div>
        </div>

        <div class="cert-card cert-card--add">
          <div class="cert-icon cert-icon--add"><i class="fas fa-plus-circle"></i></div>
          <div class="cert-body">
            <div class="cert-issuer">More Coming</div>
            <h3 class="cert-name">ISO & Further Accreditations</h3>
            <p class="cert-desc">Additional certifications and trade body memberships are in progress. This section will be updated as new credentials are obtained.</p>
            <div class="cert-tag">Upcoming</div>
          </div>
        </div>

      </div>

      <!-- Admin note (hidden in production) -->
      <!-- To add a new certificate: 1) drop the PDF/image into public/certificates/
           2) copy a .cert-card block above, update icon/issuer/name/description/tag
           3) point cert-download href to /certificates/your-file.pdf -->
    </div>
  </section>

  <!-- ====== GLOBAL REACH ====== -->
  <section id="global" class="section reach-section">
    <div class="container">
      <div class="reach-inner">
        <div class="reach-content">
          <div class="section-eyebrow">Where We Operate</div>
          <h2 class="section-title">Trading <em>Globally</em><br />from the UK</h2>
          <p>We are establishing trade lanes connecting the United Kingdom with major commodity markets across Europe, Asia, the Middle East, Africa, and the Americas.</p>
          <div class="reach-regions">
            <div class="region"><i class="fas fa-map-marker-alt"></i> Europe</div>
            <div class="region"><i class="fas fa-map-marker-alt"></i> Middle East</div>
            <div class="region"><i class="fas fa-map-marker-alt"></i> South Asia</div>
