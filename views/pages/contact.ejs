<%- include('../partials/breadcrumb', { pageTitle: 'Contact Us' }) %>

<section class="py-24 px-5 lg:px-8 bg-white">
  <div class="max-w-7xl mx-auto grid lg:grid-cols-5 gap-14">

    <!-- Info -->
    <div class="lg:col-span-2" data-aos="fade-right">
      <h2 class="font-heading font-bold text-2xl text-navy mb-6">Get in Touch</h2>
      <div class="space-y-5 mb-10">
        <div class="flex gap-4">
          <div class="w-11 h-11 shrink-0 rounded-lg bg-accent/10 flex items-center justify-center"><i data-lucide="map-pin" class="w-5 h-5 text-accent"></i></div>
          <p class="text-steel text-sm pt-2.5"><%= site.address.line1 %>, <%= site.address.city %>, <%= site.address.state %>, <%= site.address.country %></p>
        </div>
        <div class="flex gap-4">
          <div class="w-11 h-11 shrink-0 rounded-lg bg-accent/10 flex items-center justify-center"><i data-lucide="mail" class="w-5 h-5 text-accent"></i></div>
          <a href="mailto:<%= site.email %>" class="text-steel text-sm pt-2.5 hover:text-accent transition"><%= site.email %></a>
        </div>
        <div class="flex gap-4">
          <div class="w-11 h-11 shrink-0 rounded-lg bg-accent/10 flex items-center justify-center"><i data-lucide="phone" class="w-5 h-5 text-accent"></i></div>
          <p class="text-steel text-sm pt-2.5"><%= site.phonePlaceholder %></p>
        </div>
        <div class="flex gap-4">
          <div class="w-11 h-11 shrink-0 rounded-lg bg-accent/10 flex items-center justify-center"><i data-lucide="clock" class="w-5 h-5 text-accent"></i></div>
          <p class="text-steel text-sm pt-2.5">Mon – Sat: 9:00 AM – 6:00 PM</p>
        </div>
      </div>
      <div class="rounded-xl overflow-hidden border border-black/10 min-h-[220px] bg-[#e9edf1] flex items-center justify-center text-steel text-sm">
        <div class="text-center p-6"><i data-lucide="map" class="w-8 h-8 mx-auto mb-2 text-accent"></i>Google Map Embed Placeholder</div>
      </div>
    </div>

    <!-- Form -->
    <div class="lg:col-span-3" data-aos="fade-left">
      <div id="contact-form-wrap" class="p-8 md:p-10 rounded-2xl border border-black/5 shadow-sm">
        <h2 class="font-heading font-bold text-2xl text-navy mb-6">Send Us a Message</h2>
        <form id="contact-form" novalidate>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="text-sm font-medium text-navy mb-1.5 block">Name *</label>
              <input type="text" name="name" required class="w-full px-4 py-3 rounded-md border border-black/10 focus:border-accent focus:outline-none text-sm">
              <span class="error-msg text-red-500 text-xs mt-1 hidden">Please enter your name.</span>
            </div>
            <div>
              <label class="text-sm font-medium text-navy mb-1.5 block">Company</label>
              <input type="text" name="company" class="w-full px-4 py-3 rounded-md border border-black/10 focus:border-accent focus:outline-none text-sm">
            </div>
            <div>
              <label class="text-sm font-medium text-navy mb-1.5 block">Email *</label>
              <input type="email" name="email" required class="w-full px-4 py-3 rounded-md border border-black/10 focus:border-accent focus:outline-none text-sm">
              <span class="error-msg text-red-500 text-xs mt-1 hidden">Please enter a valid email.</span>
            </div>
            <div>
              <label class="text-sm font-medium text-navy mb-1.5 block">Phone</label>
              <input type="tel" name="phone" class="w-full px-4 py-3 rounded-md border border-black/10 focus:border-accent focus:outline-none text-sm">
            </div>
          </div>
          <div class="mt-5">
            <label class="text-sm font-medium text-navy mb-1.5 block">Subject *</label>
            <input type="text" name="subject" required class="w-full px-4 py-3 rounded-md border border-black/10 focus:border-accent focus:outline-none text-sm">
            <span class="error-msg text-red-500 text-xs mt-1 hidden">Please enter a subject.</span>
          </div>
          <div class="mt-5">
            <label class="text-sm font-medium text-navy mb-1.5 block">Message *</label>
            <textarea name="message" rows="5" required class="w-full px-4 py-3 rounded-md border border-black/10 focus:border-accent focus:outline-none text-sm"></textarea>
            <span class="error-msg text-red-500 text-xs mt-1 hidden">Please enter a message.</span>
          </div>

          <!-- CAPTCHA placeholder — swap for reCAPTCHA / hCaptcha widget in production -->
          <div class="mt-5 flex items-center gap-3 p-4 rounded-md bg-[#F5F7FA] text-sm text-steel">
            <input type="checkbox" id="captcha-placeholder" required class="w-4 h-4 accent-accent">
            <label for="captcha-placeholder">I'm not a robot (CAPTCHA placeholder)</label>
          </div>

          <button type="submit" id="contact-submit-btn" class="mt-7 w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent/90 text-white font-semibold px-8 py-3.5 rounded-md transition">
            <span id="submit-label">Send Message</span>
            <i id="submit-spinner" data-lucide="loader-2" class="w-4 h-4 hidden animate-spin"></i>
          </button>
        </form>
      </div>

      <!-- Success screen -->
      <div id="contact-success" class="hidden p-10 rounded-2xl border border-black/5 text-center">
        <div class="w-16 h-16 mx-auto rounded-full bg-green-100 flex items-center justify-center mb-5">
          <i data-lucide="check" class="w-8 h-8 text-green-600"></i>
        </div>
        <h3 class="font-heading font-bold text-xl text-navy mb-2">Message Sent Successfully</h3>
        <p class="text-steel text-sm">Thank you for reaching out. Our team will get back to you shortly.</p>
      </div>
    </div>
  </div>
</section>

<!-- Toast -->
<div id="toast" class="hidden fixed bottom-6 right-6 bg-navy text-white px-5 py-3.5 rounded-lg shadow-xl text-sm z-[80]"></div>

<!-- EmailJS SDK -->
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script src="/js/contact.js"></script>
