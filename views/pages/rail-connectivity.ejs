<%- include('../partials/breadcrumb', { pageTitle: 'Rail Connectivity' }) %>

<section class="py-24 px-5 lg:px-8 bg-white">
  <div class="max-w-7xl mx-auto">
    <p data-aos="fade-up" class="text-steel max-w-2xl mb-16">
      CFS-OWPL is directly connected to major Inland Container Depots (ICDs) and railheads, enabling efficient, cost-effective rail-based cargo movement.
    </p>

    <!-- Connection diagram -->
    <div data-aos="fade-up" class="rail-track relative rounded-2xl bg-navy p-10 md:p-16 mb-16">
      <div class="flex flex-col items-center">
        <div class="bg-accent text-white font-heading font-bold px-6 py-3 rounded-lg mb-10 flex items-center gap-2">
          <i data-lucide="train-front" class="train-icon w-5 h-5"></i> CFS-OWPL, Ludhiana
        </div>
        <div class="w-px h-10 bg-white/20 rail-pulse"></div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 w-full">
          <% railheads.forEach((r, i) => { %>
            <div data-aos="zoom-in" data-aos-delay="<%= i * 80 %>" class="flex flex-col items-center">
              <div class="w-px h-6 bg-white/20 rail-pulse" style="animation-delay: <%= i * 0.15 %>s"></div>
              <div class="bg-white/10 hover:bg-accent/20 border border-white/10 hover:border-accent transition rounded-lg px-4 py-3 text-white text-sm font-medium text-center w-full">
                <i data-lucide="train-front" class="w-5 h-5 mx-auto mb-2 text-accent"></i>
                <%= r %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% railheads.forEach((r, i) => { %>
        <div data-aos="fade-up" data-aos-delay="<%= (i % 3) * 100 %>" class="p-6 rounded-xl border border-black/5">
          <i data-lucide="train-front" class="w-7 h-7 text-accent mb-3"></i>
          <h3 class="font-heading font-semibold text-navy"><%= r %></h3>
          <p class="text-steel text-sm mt-1">Direct railhead connection for import/export cargo movement.</p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
