<%- include('../partials/breadcrumb', { pageTitle: 'Notice Board' }) %>

<section class="py-24 px-5 lg:px-8 bg-white">
  <div class="max-w-5xl mx-auto">

    <!-- Search + Filters -->
    <div data-aos="fade-up" class="flex flex-col sm:flex-row gap-4 mb-10">
      <div class="relative flex-1">
        <i data-lucide="search" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-steel"></i>
        <input id="notice-search" type="text" placeholder="Search notices..." class="w-full pl-11 pr-4 py-3 rounded-md border border-black/10 focus:border-accent focus:outline-none text-sm">
      </div>
      <select id="notice-category" class="px-4 py-3 rounded-md border border-black/10 text-sm focus:border-accent focus:outline-none">
        <option value="all">All Categories</option>
        <option value="tariff">Tariff</option>
        <option value="operations">Operations</option>
        <option value="customs">Customs</option>
      </select>
    </div>

    <div id="notice-list" class="space-y-5">
      <% notices.sort((a,b) => b.pinned - a.pinned).forEach((n, i) => { %>
        <div data-aos="fade-up" data-aos-delay="<%= (i % 4) * 60 %>" class="notice-card p-6 rounded-xl border border-black/5 hover:border-accent/30 hover:shadow-md transition-all relative" data-category="<%= n.category.toLowerCase() %>" data-title="<%= n.title.toLowerCase() %>">
          <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-2 flex-wrap">
              <% if (n.pinned) { %><i data-lucide="pin" class="w-4 h-4 text-accent"></i><% } %>
              <span class="text-xs font-semibold text-accent bg-accent/10 px-2.5 py-1 rounded-full"><%= n.category %></span>
              <% if (n.isNew) { %><span class="text-[10px] font-bold text-white bg-accent px-2 py-0.5 rounded-full animate-pulse">NEW</span><% } %>
            </div>
            <span class="text-xs text-steel"><%= new Date(n.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> &middot; <%= n.time %></span>
          </div>
          <h3 class="font-heading font-semibold text-lg text-navy mb-2"><%= n.title %></h3>
          <p class="text-steel text-sm leading-relaxed mb-4"><%= n.description %></p>
          <a href="<%= n.pdf %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-accent text-sm font-semibold hover:gap-2.5 transition-all">
            <i data-lucide="download" class="w-4 h-4"></i> Download Attachment
          </a>
        </div>
      <% }) %>
    </div>

    <p id="no-results" class="hidden text-center text-steel text-sm py-10">No notices match your search.</p>

    <div class="text-center mt-12" data-aos="fade-up">
      <a href="/future/circulars" class="text-accent text-sm font-semibold hover:underline">View Notice Archive &rarr;</a>
    </div>
  </div>
</section>
