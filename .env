PORT=3000
NODE_ENV=production
SITE_URL=https://www.owpl-cfs.com
SITE_NAME=Overseas Warehousing Pvt. Ltd.
CONTACT_EMAIL=info@owpl-cfs.com
# EmailJS (used client-side in public/js/contact.js)
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# Admin panel (Notice Board management at /admin/notices) — set a real password before deploying
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Cloud file storage for PDF uploads (optional, but REQUIRED if deploying to
# Vercel or any serverless host — their local filesystem is read-only and
# ephemeral, so uploads through /admin/notices will silently vanish without
# this configured). Leave all blank to use local disk (public/pdf/) — fine
# for a normal server or localhost. Works with AWS S3, Cloudflare R2,
# Backblaze B2, or any S3-compatible provider.
# Run `npm install @aws-sdk/client-s3` before enabling this.
S3_BUCKET=owpl-notices
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=fbd33a40820863dc7ab7e798aa50ea26
S3_SECRET_ACCESS_KEY=a5c75b07ef944df48828cddb06ca7666704cff10718de8889d34ff5c7bfe6643
S3_ENDPOINT=https://qyfvqlrimzsoncflvquu.supabase.co/storage/v1/s3
S3_PUBLIC_URL_BASE=https://qyfvqlrimzsoncflvquu.supabase.co/storage/v1/object/public/owpl-notices
